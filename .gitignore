pipeline/data/*.tsv
pipeline/data/*.xls
pipeline/data/jlpt_n*.csv
# Noto CJK/Arapça fontları büyük (17MB+) ve Google/Noto'nun kendi
# reposundan yeniden indirilebilir -- Fraunces/IBM Plex Mono (küçük,
# zaten depoda) gibi committed asset olarak tutulmuyor.
pipeline/assets/fonts/NotoSansCJK*.otf
pipeline/assets/fonts/NotoNaskhArabic*.ttf

