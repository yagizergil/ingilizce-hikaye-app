# Pipeline-only secrets. NEVER copy these into the app's .env — this file
# holds the service_role key, which must never ship inside the mobile bundle.

# Doğrudan Postgres bağlantısı (Supabase proje ayarları -> Database ->
# Connection string -> URI, "Session" veya "Transaction" mode pooler değil,
# psycopg3 COPY için doğrudan bağlantı kullan).
DATABASE_URL=postgresql://postgres:xxxxx@db.xxxxx.supabase.co:5432/postgres

SUPABASE_URL=https://xxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxx

# Sadece tr_gloss (Türkçe kelime çevirisi) üretiminde kullanılır.
ANTHROPIC_API_KEY=sk-ant-xxxxx
