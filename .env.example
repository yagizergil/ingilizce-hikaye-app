# Copy to .env and fill in. Only EXPO_PUBLIC_* variables are readable by the app bundle.
# NEVER put a service_role key here — that belongs only in pipeline/.env and Supabase project secrets.

EXPO_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxx
EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=appl_xxxxx

# Google Cloud Console'dan alınan iOS OAuth client ID (Supabase Auth ->
# Providers -> Google ile eşleşmeli). Sadece "Google ile giriş" için gerekli.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=xxxxx.apps.googleusercontent.com

# Abonelik ekranindaki zorunlu yasal baglantilar (Guideline 3.1.2(a)).
# TERMS bos birakilirsa Apple'in standart EULA'si kullanilir.
# PRIVACY ZORUNLU: docs/PRIVACY.md metnini herhangi bir statik sayfada
# barindir ve URL'i buraya yaz. Bos birakilirsa paywall uyari gosterir ve
# App Store gonderimi yapilmamalidir.
EXPO_PUBLIC_TERMS_URL=https://www.apple.com/legal/internet-services/itunes/dev/stdeula/
EXPO_PUBLIC_PRIVACY_URL=https://ornek.com/gizlilik
