# react-i18next@15 hala `typescript@^5` peer'i istiyor; Expo SDK 57 ise
# typescript@~6.0.3 getiriyor. Bu yalnizca bir tip-denetleyici surum
# uyusmazligi (calisma zamanini etkilemiyor); react-i18next@17'ye gecmek
# i18next 23 -> 26 gibi cok daha riskli bir sicramayi zorunlu kilardi.
# Duz `npm install` calissin diye cozumleyiciyi burada gevsetiyoruz.
legacy-peer-deps=true
